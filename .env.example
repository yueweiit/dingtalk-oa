# PostgreSQL 数据库配置
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=dingtalk_oa

# 钉钉应用配置
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret

# 钉钉企业 ID（可选，首次收到事件时自动获取）
DINGTALK_CORP_ID=your_corp_id

# 钉钉审批模板管理用户 ID（必须拥有模板管理权限）
DINGTALK_TEMPLATE_ADMIN_USER_ID=17600775501628783

# 附件归档授权身份（使用仍在职且已验证可访问审批附件的服务/管理员账号）
DINGTALK_ARCHIVE_DOWNLOAD_USER_ID=replace_with_active_user_id
# 可选：已知 unionId 时可避免每批重复查询
DINGTALK_ARCHIVE_DOWNLOAD_UNION_ID=

# Kafka 配置（可选，暂未安装时可留空）
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dingtalk-oa
KAFKA_GROUP_ID=dingtalk-oa-group

# Webhook 配置（备用）
WEBHOOK_TOKEN=your_webhook_token
WEBHOOK_AES_KEY=your_aes_key

# Backfill 配置
BACKFILL_LOOKBACK_DAYS=1
BACKFILL_WINDOW_DAYS=30

# 审批中状态核对：Kafka / Stream 漏事件的限量兜底
APPROVAL_STATUS_RECONCILE_CRON=*/15 * * * *
APPROVAL_STATUS_RECONCILE_BATCH_SIZE=100
APPROVAL_STATUS_RECONCILE_DELAY_MS=500

# 已完成物流审批及物流服务采购：部署 20260909000000 迁移后设为 true
COMPLETED_APPROVAL_REFRESH_ENABLED=false
COMPLETED_APPROVAL_REFRESH_CRON=*/30 * * * *
COMPLETED_APPROVAL_REFRESH_BATCH_SIZE=10
COMPLETED_APPROVAL_REFRESH_DELAY_MS=1000
COMPLETED_APPROVAL_REFRESH_MIN_INTERVAL_SECONDS=21600

# 成本系统附件归档（专用非 root MinIO 账号）
ARCHIVE_MINIO_ENDPOINT=172.19.49.226
ARCHIVE_MINIO_PORT=9000
ARCHIVE_MINIO_USE_SSL=false
ARCHIVE_MINIO_ACCESS_KEY=costing_archiver
ARCHIVE_MINIO_SECRET_KEY=replace_with_secret
ARCHIVE_MINIO_BUCKET=dingtalk-approval-archive
ARCHIVE_BATCH_SIZE=10
ARCHIVE_DELAY_MS=1000
# 受控历史恢复时临时设为 true，仅领取每流程的样本附件；常规定时任务保持 false
ARCHIVE_RECOVERY_CANARY_ONLY=false

# 日志级别
LOG_LEVEL=info

# 服务端口
PORT=3000

# Seed financial history with finance:backfill; scheduler resumes durable windows.
FINANCIAL_BACKFILL_ENABLED=false
FINANCIAL_BACKFILL_CRON=*/10 * * * *
FINANCIAL_BACKFILL_MAX_WINDOWS=1
