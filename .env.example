# PostgreSQL 数据库配置
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=dingtalk_oa

# 钉钉应用配置
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret

# 钉钉企业 ID（可选，首次收到事件时自动获取）
DINGTALK_CORP_ID=your_corp_id

# 钉钉审批模板管理用户 ID（必须拥有模板管理权限）
DINGTALK_TEMPLATE_ADMIN_USER_ID=17600775501628783

# 附件归档授权身份（使用仍在职且已验证可访问审批附件的服务/管理员账号）
DINGTALK_ARCHIVE_DOWNLOAD_USER_ID=replace_with_active_user_id
# 可选：已知 unionId 时可避免每批重复查询
DINGTALK_ARCHIVE_DOWNLOAD_UNION_ID=

# Kafka 配置（可选，暂未安装时可留空）
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dingtalk-oa
KAFKA_GROUP_ID=dingtalk-oa-group

# Webhook 配置（备用）
WEBHOOK_TOKEN=your_webhook_token
WEBHOOK_AES_KEY=your_aes_key

# 审批与附件只读 HTTP API 无需 Token，直接按 corpId 查询。
# 每个应用进程按来源 IP 分别限流，三个读取接口共用该来源的额度。
APPROVAL_READ_API_REQUESTS_PER_MINUTE=120
# 仅通过参数及游标验证、准备访问数据库的请求占用总额度。
APPROVAL_READ_API_TOTAL_REQUESTS_PER_MINUTE=1200
# 可选内部游标签名密钥，不用于调用鉴权；不设置时从现有 DINGTALK_APP_SECRET 派生。
# 多实例需使用相同签名配置，轮换后旧游标失效。
# APPROVAL_READ_API_CURSOR_SECRET=<至少32字符的共享随机值>
# 下载：打开对象（含区域查询）、无数据空闲、整个传输的超时，单位毫秒。
# 超时会取消底层存储请求；此配置只影响 HTTP 下载，不改变后台附件归档。
APPROVAL_READ_API_DOWNLOAD_OPEN_TIMEOUT_MS=10000
APPROVAL_READ_API_DOWNLOAD_IDLE_TIMEOUT_MS=30000
APPROVAL_READ_API_DOWNLOAD_TOTAL_TIMEOUT_MS=300000

# Backfill 配置
BACKFILL_LOOKBACK_DAYS=1
BACKFILL_WINDOW_DAYS=30

# 审批中状态核对：Kafka / Stream 漏事件的限量兜底
APPROVAL_STATUS_RECONCILE_CRON=*/15 * * * *
APPROVAL_STATUS_RECONCILE_BATCH_SIZE=100
APPROVAL_STATUS_RECONCILE_DELAY_MS=500

# 预算与 OA 统一预警机器人（企业内部机器人；凭据仅保存于 .env）
# DINGTALK_ALERT_ROBOT_CODE=your_robot_code
# DINGTALK_ALERT_CLIENT_ID=your_robot_client_id
# DINGTALK_ALERT_CLIENT_SECRET=your_robot_client_secret
# DINGTALK_ALERT_RECIPIENT_USER_IDS=1234567890
# APPROVAL_TIMEOUT_PROCESS_CODES=PROC-EXAMPLE-1,PROC-EXAMPLE-2
# APPROVAL_TIMEOUT_MONITOR_CRON=*/30 * * * *
# APPROVAL_TIMEOUT_MINUTES=1440
# APPROVAL_TIMEOUT_WINDOW_BEFORE_MINUTES=40
# APPROVAL_TIMEOUT_WINDOW_AFTER_MINUTES=40
# 提交后立即预测实际审批路径，并对没有审批人的节点告警
# APPROVAL_EMPTY_NODE_PROCESS_CODES=PROC-EXAMPLE-1,PROC-EXAMPLE-2

# 预算预警（OA 只读取预算汇总，不读取支出明细）
# BUDGET_ALERT_PROCESS_CODES=PROC-EXAMPLE-1
# BUDGET_ALERT_API_URL=http://127.0.0.1:3001/api/dingtalk/alert-budget-snapshot
# BUDGET_ALERT_API_KEY=replace_with_the_same_long_random_secret_as_budget_service
# 普通表单：splits 留空，按服务主体和主金额查询。
# 部门拆分表单：splits 中明确配置表格、部门列和金额列组件 ID；同部门多行会先合并。
# BUDGET_ALERT_FIELD_MAP={"PROC-EXAMPLE-1":{"applicationDateFieldId":"DDDateField_EXAMPLE","budgetTypeFieldId":"DDSelectField_EXAMPLE","serviceEntityFieldId":"CascadeField_EXAMPLE","amountFieldId":"MoneyField_EXAMPLE","splits":[]},"PROC-SPLIT-EXAMPLE":{"applicationDateFieldId":"DDDateField_EXAMPLE","budgetTypeFieldId":"DDSelectField_EXAMPLE","serviceEntityFieldId":"CascadeField_EXAMPLE","amountFieldId":"MoneyField_EXAMPLE","splits":[{"tableFieldId":"TableField_EXAMPLE","departmentFieldId":"DepartmentField_EXAMPLE","amountFieldId":"MoneyField_SPLIT_EXAMPLE"}]}}
# 已完成物流审批及物流服务采购：部署 20260909000000 迁移后设为 true
COMPLETED_APPROVAL_REFRESH_ENABLED=false
COMPLETED_APPROVAL_REFRESH_CRON=*/30 * * * *
COMPLETED_APPROVAL_REFRESH_BATCH_SIZE=10
COMPLETED_APPROVAL_REFRESH_DELAY_MS=1000
COMPLETED_APPROVAL_REFRESH_MIN_INTERVAL_SECONDS=21600

# 成本系统附件归档（专用非 root MinIO 账号）
ARCHIVE_MINIO_ENDPOINT=172.19.49.226
ARCHIVE_MINIO_PORT=9000
ARCHIVE_MINIO_USE_SSL=false
ARCHIVE_MINIO_ACCESS_KEY=costing_archiver
ARCHIVE_MINIO_SECRET_KEY=replace_with_secret
ARCHIVE_MINIO_BUCKET=dingtalk-approval-archive
ARCHIVE_BATCH_SIZE=10
ARCHIVE_DELAY_MS=1000
# 受控历史恢复时临时设为 true，仅领取每流程的样本附件；常规定时任务保持 false
ARCHIVE_RECOVERY_CANARY_ONLY=false

# 日志级别
LOG_LEVEL=info

# 服务端口
PORT=3000
# 明确配置可信代理 IP/CIDR，逗号分隔；空值表示忽略转发头。
HTTP_TRUSTED_PROXIES=
# 宝塔 Nginx 与应用同机且代理通过回环访问时可设：
# HTTP_TRUSTED_PROXIES=127.0.0.1,::1

# Seed financial history with finance:backfill; scheduler resumes durable windows.
FINANCIAL_BACKFILL_ENABLED=false
FINANCIAL_BACKFILL_CRON=7,17,27,37,47,57 * * * *
FINANCIAL_BACKFILL_DELAY_MS=2000
FINANCIAL_BACKFILL_MAX_WINDOWS=1
